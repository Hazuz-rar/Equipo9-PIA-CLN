# Usa valores de ejemplo. Nunca publiques tu archivo .env real.
APP_NAME=Hotel Costa Azul API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Exclusivo para la base de datos que inicia Docker Compose.
POSTGRES_DB=hotel_costa_azul
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_EN_EL_ENV

# Para iniciar Python directamente, conecta con la BD accesible desde Windows.
# Docker Compose sobrescribe DATABASE_URL dentro de los contenedores.
DATABASE_URL=postgresql+psycopg://hotel_user:CAMBIA_ESTA_CLAVE_EN_EL_ENV@localhost:5433/hotel_costa_azul
